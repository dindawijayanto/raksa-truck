# Untuk development dengan Vite proxy, nilai ini tidak perlu diisi.
# Untuk frontend yang di-host terpisah, isi URL endpoint API yang dapat diakses browser.
# VITE_MODEL_API_URL=https://api.example.com/api/v1/model-b/predict

# Opsional: tujuan proxy Vite saat `npm run dev`.
# VITE_API_PROXY_TARGET=http://localhost:8000
